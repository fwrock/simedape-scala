# SimEDaPE — variáveis de ambiente
# Copie este ficheiro para .env e edite conforme o seu ambiente.
# O ficheiro .env é carregado automaticamente pelo docker compose.

# ── ClickHouse do simulador ────────────────────────────────────────────────────
# O ClickHouse usa network_mode: host no compose do simulador.
# De dentro de um container Docker no Linux, o host é acessível via
# host.docker.internal (resolvido pelo extra_hosts: host-gateway no compose).
SIMEDAPE_CH_HOST=host.docker.internal
SIMEDAPE_CH_PORT=8123
SIMEDABE_CH_DATABASE=htc
SIMEDAPE_CH_USER=default
SIMEDAPE_CH_PASSWORD=
SIMEDAPE_CH_POOL_SIZE=8

# ── Rede do simulador ──────────────────────────────────────────────────────────
# Não é necessária configuração de rede Docker — o ClickHouse usa host networking.

# ── Pipeline ───────────────────────────────────────────────────────────────────
SIMEDAPE_DATA_SOURCE=clickhouse
SIMEDAPE_BASE_SIM_ID=base-2017
SIMEDAPE_PARTIAL_SIM_ID=partial-2017
SIMEDAPE_OUTPUT_SIM_ID=estimated-2017
SIMEDAPE_N_CLUSTERS=64

# Diretório local com dados de simulação (apenas para DATA_SOURCE=file)
SIMEDAPE_DATA_DIR=./data

# ── HTTP API ───────────────────────────────────────────────────────────────────
SIMEDAPE_HTTP_PORT=9000
# true = dispara o pipeline automaticamente ao subir o container
SIMEDAPE_AUTO_START=false

# ── Validação ──────────────────────────────────────────────────────────────────
# Disabled | AgainstBase | AgainstReference
SIMEDAPE_VALIDATION_MODE=Disabled
SIMEDAPE_VALIDATION_REF_ID=
